# Copy this file to .env and configure it
# Log filter level (e.g. error, warn, info, debug, trace)
RUST_LOG=info

# HTTP Server Configuration
HTTP_HOST=127.0.0.1
HTTP_PORT=3036

# WebSocket Configuration
# Enable/disable public broadcasting
WS_PUBLIC_BROADCASTS=true

# Comma-separated allowed origins to guard against CSWSH (Cross-Site WebSocket Hijacking)
WS_ALLOWED_ORIGINS=http://127.0.0.1:3036,http://localhost:3036
